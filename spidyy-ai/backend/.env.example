# Copy this file to .env and fill in real values. Never commit .env.

# Get a key from Google AI Studio: https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Check Google's current model list before changing this.
GEMINI_MODEL=gemini-3.1-flash-lite
# Optional: backup model tried only when the main one is overloaded (503) or rate-limited (429).
GEMINI_FALLBACK_MODEL=gemini-3.8-flash

# URL of the React dev server (used for CORS).
FRONTEND_ORIGIN=http://localhost:5173

# Semantic question grouping (see similarity.py). Groups are recorded only; answers are not reused yet.
SIMILARITY_ENABLED=true
# Cosine similarity needed to join an existing group, in (0, 1]. Tune it on your own questions.
SIMILARITY_THRESHOLD=0.80
# Also require the same question intent ("types of", "example of", ...) and the same numbers.
SIMILARITY_INTENT_GUARD=true
# Enables POST /api/similarity/check, which shows stored questions. Development only.
SIMILARITY_DEBUG_ENDPOINT=false

# Phase 2: store answered questions, their groups and counts in PostgreSQL. Leave unset to keep
# grouping in memory only. Storing questions from real students is data collection: get approval
# first (see evaluation/DATA_COLLECTION_PLAN.md). Never commit the real value.
# DATABASE_URL=postgresql+psycopg://spidyy_app:CHANGE_ME@localhost:5432/spidyy
